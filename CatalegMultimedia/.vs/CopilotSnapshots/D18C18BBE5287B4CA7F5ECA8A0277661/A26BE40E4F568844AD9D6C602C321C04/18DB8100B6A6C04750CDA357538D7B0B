using System;
using System.Collections.Generic;
using System.Text;

namespace SugarSyntax.Model
{
    public class ArtDigital
    {
        // Propietats automàtiques públiques
        public string Id { get; set; }
        public string Titol { get; set; }
        public string Autor { get; set; }
        public int AnyCreacio { get; set; }
        public string Etiquetes { get; set; }
        public string RutaFitxer { get; set; }
        public int Amplada { get; set; }
        public int Alcada { get; set; }
        public string EspaiColor { get; set; }
        public int ResolucioDPI { get; set; }
        public string TipusCompressio { get; set; }
        public string SoftwareUtilitzat { get; set; }

        // Constructor buit
        public ArtDigital() { }

        // Constructor amb tots els paràmetres i valors per defecte
        public ArtDigital(
            string id = "",
            string titol = "",
            string autor = "",
            int anyCreacio = 0,
            string etiquetes = "",
            string rutaFitxer = "",
            int amplada = 0,
            int alcada = 0,
            string espaiColor = "",
            int resolucioDPI = 0,
            string tipusCompressio = "",
            string softwareUtilitzat = "")
        {
            Id = id;
            Titol = titol;
            Autor = autor;
            AnyCreacio = anyCreacio;
            Etiquetes = etiquetes;
            RutaFitxer = rutaFitxer;
            Amplada = amplada;
            Alcada = alcada;
            EspaiColor = espaiColor;
            VersioSVG = versioSVG;
            NombreVectors = nombreVectors;
            TeFonsTransparent = teFonsTransparent;
            Empresa = empresa;
            ManualIdentitatUrl = manualIdentitatUrl;
        }

        // Constructor des de línia CSV
        public ArtDigital(string liniaCSV)
        {
            string[] camps = liniaCSV.Split(';');
            Id = camps[0];
            Titol = camps[1];
            Autor = camps[2];
            AnyCreacio = int.Parse(camps[3]);
            Etiquetes = camps[4];
            RutaFitxer = camps[5];
            Amplada = int.Parse(camps[6]);
            Alcada = int.Parse(camps[7]);
            EspaiColor = camps[8];
            ResolucioDPI = int.Parse(camps[9]);
            TipusCompressio = camps[10];
            SoftwareUtilitzat = camps[11];
        }

        // ToString
        public override string ToString() =>
            $"[ArtDigital] {Titol} ({AnyCreacio}) - {Autor}";

        // Equals
        public override bool Equals(object? obj) =>
            obj is ArtDigital altre && Id == altre.Id;
    }
}
