using System;
using System.Collections.Generic;
using System.Text;

namespace SugarSyntax.Model
{
    public class Pelicula
    {
        // Propietats automàtiques públiques
        public string Id { get; set; }
        public string Titol { get; set; }
        public string Autor { get; set; }
        public int AnyCreacio { get; set; }
        public string Etiquetes { get; set; }
        public string RutaFitxer { get; set; }
        public int Amplada { get; set; }
        public int Alcada { get; set; }
        public string EspaiColor { get; set; }
        public string Resolucio { get; set; }
        public int FrameRate { get; set; }
        public int DuradaSegons { get; set; }
        public string Director { get; set; }
        public string ClassificacioEdat { get; set; }

        // Constructor buit
        public Pelicula() { }

        // Constructor amb tots els paràmetres i valors per defecte
        public Pelicula(
            string id = "",
            string titol = "",
            string autor = "",
            int anyCreacio = 0,
            string etiquetes = "",
            string rutaFitxer = "",
            int amplada = 0,
            int alcada = 0,
            string espaiColor = "",
            string resolucio = "",
            int frameRate = 0,
            int duradaSegons = 0,
            string director = "",
            string classificacioEdat = "")
        {
            Id = id;
            Titol = titol;
            Autor = autor;
            AnyCreacio = anyCreacio;
            Etiquetes = etiquetes;
            RutaFitxer = rutaFitxer;
            Amplada = amplada;
            Alcada = alcada;
            EspaiColor = espaiColor;
            Resolucio = resolucio;
            FrameRate = frameRate;
            DuradaSegons = duradaSegons;
            Director = director;
            ClassificacioEdat = classificacioEdat;
        }

        // Constructor des de línia CSV
        public Pelicula(string liniaCSV)
        {
            string[] camps = liniaCSV.Split(';');
            Id = camps[0];
            Titol = camps[1];
            Autor = camps[2];
            AnyCreacio = int.Parse(camps[3]);
            Etiquetes = camps[4];
            RutaFitxer = camps[5];
            Amplada = int.Parse(camps[6]);
            Alcada = int.Parse(camps[7]);
            EspaiColor = camps[8];
            Resolucio = camps[9];
            FrameRate = int.Parse(camps[10]);
            DuradaSegons = int.Parse(camps[11]);
            Director = camps[12];
            ClassificacioEdat = camps[13];
        }

        // ToString
        public override string ToString() =>
            $"[Pelicula] {Titol} ({AnyCreacio}) - {Autor}";

        // Equals
        public override bool Equals(object? obj) =>
            obj is Pelicula altre && Id == altre.Id;
    }
}
